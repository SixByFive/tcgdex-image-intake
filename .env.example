PORT=4102
NODE_ENV=production

API_KEY=your-secret-api-key

MAX_UPLOAD_MB=100

# MinIO root credentials (used only for MinIO setup/admin)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-use-a-strong-password

# MinIO service credentials (used by minio-init to create the local bucket/user)
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=tcgdex-images

# External S3 upload destination (used by the intake service)
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=your-bucket-name

ALLOWED_ORIGINS=https://dev.sixbyfive.com,http://localhost:3000/